# Copy to secrets/.env and fill in:  cp secrets/.env.example secrets/.env

# Required
DISCORD_TOKEN=your-discord-bot-token
GEMINI_API_KEY=your-gemini-api-key

# Google Sheet (shared with the service-account email as Editor).
# GOOGLE_SHEET_ID is the long ID in the sheet URL and is preferred over the name.
GOOGLE_SHEET_NAME=Macro Tracker
GOOGLE_SHEET_ID=

# Service-account credentials: a file path (default secrets/credentials.json), or the
# JSON inline / base64-encoded for hosts that only support env vars.
# GOOGLE_CREDENTIALS_FILE=secrets/credentials.json
# GOOGLE_CREDENTIALS_JSON=
# GOOGLE_CREDENTIALS_B64=

# Only members of this Discord server can use the bot (right-click the server
# with Developer Mode on -> Copy Server ID). Leave empty to allow anyone.
ALLOWED_GUILD_ID=

# Timezone used until a user sets their own (IANA name).
DEFAULT_TIMEZONE=America/Los_Angeles

# Optional
# GEMINI_MODEL=gemini-3.6-flash
# Tried in order when the main model is overloaded (503) or rate-limited (429).
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
# RATE_LIMIT_COUNT=10
# RATE_LIMIT_SECONDS=60
# LOG_LEVEL=INFO
# DB_PATH=data/user_data.db
