# Secrets (CRITICAL): everything in secrets/ except the template and its README
secrets/*
!secrets/.env.example
!secrets/README.md
# Also block secret files anywhere else, in case one is misplaced
.env
credentials.json
oauth_client.json

# Bot database and backups
data/
storage/
*.db
*.db.bak
*.sqlite3

# Exclude virtual environments
.venv/
env/
venv/

# Exclude Python cache/system files
__pycache__/
*.pyc
.DS_Store

# Written on the Pi by deploy/deploy.sh for --rollback
.deploy-previous
